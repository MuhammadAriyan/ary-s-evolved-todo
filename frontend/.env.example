# Better Auth Configuration
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your-better-auth-secret-here
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/todo_dev

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Backend API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8001

# WebSocket Configuration
NEXT_PUBLIC_WEBSOCKET_RECONNECT_INTERVAL=5000
NEXT_PUBLIC_WEBSOCKET_MAX_RECONNECT_ATTEMPTS=10

# Feature Flags
NEXT_PUBLIC_ENABLE_REAL_TIME_SYNC=true
NEXT_PUBLIC_ENABLE_REMINDERS=true
NEXT_PUBLIC_ENABLE_RECURRING_TASKS=true
NEXT_PUBLIC_ENABLE_SEARCH=true
NEXT_PUBLIC_ENABLE_AUDIT_LOGS=true
NEXT_PUBLIC_ENABLE_COLLABORATION=false

# Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# Environment
NEXT_PUBLIC_ENVIRONMENT=development

# Application Configuration
NEXT_PUBLIC_APP_NAME=Todo App
NEXT_PUBLIC_APP_VERSION=1.0.0

# Notification Configuration
NEXT_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=false
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
