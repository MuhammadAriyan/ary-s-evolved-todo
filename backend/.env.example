# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/todo_dev

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Better Auth Configuration
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your-better-auth-secret-here

# Dapr Configuration
DAPR_HTTP_PORT=3500
DAPR_GRPC_PORT=50001
DAPR_PUBSUB_NAME=kafka-pubsub
DAPR_STATE_STORE_NAME=redis-state

# Redis Configuration (for direct access if needed)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Kafka/Redpanda Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC_TASK_EVENTS=task-events
KAFKA_TOPIC_TASK_UPDATES=task-updates
KAFKA_TOPIC_REMINDERS=reminders
KAFKA_TOPIC_AUDIT_LOGS=audit-logs

# Email Service Configuration (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Todo App

# Application Configuration
APP_NAME=Todo App
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API Configuration
API_V1_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000

# WebSocket Configuration
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8001
WEBSOCKET_PING_INTERVAL=30
WEBSOCKET_PING_TIMEOUT=10

# Monitoring Configuration
PROMETHEUS_PORT=9090
ENABLE_METRICS=true
ENABLE_TRACING=false

# Performance Configuration
MAX_CONNECTIONS=100
POOL_SIZE=20
POOL_TIMEOUT=30
QUERY_TIMEOUT=30

# Feature Flags
ENABLE_REAL_TIME_SYNC=true
ENABLE_REMINDERS=true
ENABLE_RECURRING_TASKS=true
ENABLE_SEARCH=true
ENABLE_AUDIT_LOGS=true
ENABLE_COLLABORATION=false

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Timezone Configuration
DEFAULT_TIMEZONE=UTC
